DATABASE_URL="postgresql://postgres:postgres@localhost:5433/irs_az?schema=public"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production-too"
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_KEY="change-me-to-a-16-byte-key"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Folder of scanned source books (<key>.pdf, e.g. anl-8283.pdf); unset = no scans offered
SCANS_DIR=""
# Public address of the web app: links in downloads, mail, IndexNow, Telegram; required in production
SITE_URL="http://localhost:3000"
# Reader sign-in. Without MAIL_API_KEY codes are written to the log (development only;
# in production sign-in by email is then off)
MAIL_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: poem of the day to a Telegram channel, once a day from this hour (Baku time).
# State (the date last posted) is kept in TELEGRAM_STATE, default /data/telegram-state.json
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL=""
TELEGRAM_POST_HOUR=9
