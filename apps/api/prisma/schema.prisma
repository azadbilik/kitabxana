generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ─────────────────────────────────────

enum Language {
  AZ_LATIN
  AZ_ARABIC
  AZ_CYRILLIC
  FA
  AR
  RU
  EN
  TR
  DE
}

enum ScriptDirection {
  LTR
  RTL
}

enum Genre {
  POEM
  PROSE
  PLAY
  ESSAY
  PHILOSOPHY
  LETTER
  MEMOIR
}

enum PoemForm {
  GHAZAL
  MASNAVI
  RUBAI
  QASIDA
  MURABBA
  FREE_VERSE
  OTHER
}

enum AuthorType {
  POET
  WRITER
  PHILOSOPHER
  PLAYWRIGHT
  CRITIC
  FOLK
}

enum TranslationType {
  TRANSLATION
  TRANSLITERATION
  MODERNIZATION
}

enum UserRole {
  SUPERADMIN
  EDITOR
  CONTRIBUTOR
  READER
}

enum SubmissionType {
  AUTHOR
  WORK
  TRANSLATION
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ── USER ──────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Staff accounts have one; readers sign in with Google or an emailed code and need none
  username     String?  @unique
  name         String?
  passwordHash String?
  role         UserRole @default(READER)
  avatarUrl    String?
  bio          String?
  isVerified   Boolean  @default(false)
  isBanned     Boolean  @default(false)
  // Google account subject, for "Continue with Google"
  googleSub    String?  @unique
  // UI language the reader last used (az, ru, en), for mail
  locale       String?

  submissions Submission[]
  blogPosts   BlogPost[]

  sessions     Session[]
  favorites    Favorite[]
  readingState ReadingState[]
  bookState    BookState[]
  readingLists ReadingList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── AUTHOR ────────────────────────────────────

model Author {
  id   String @id @default(cuid())
  slug String @unique

  nameAz String
  nameRu String?
  nameFa String?
  nameEn String?

  bornYear       Int?
  bornYearApprox Boolean @default(false)
  diedYear       Int?
  diedYearApprox Boolean @default(false)
  bornPlace      String?
  diedPlace      String?

  type         AuthorType @default(POET)
  period       String?
  writingLangs Language[]

  bioAz      String? @db.Text
  bioRu      String? @db.Text
  bioEn      String? @db.Text
  /// Where each bio came from, per language: { az?: { wiki: "az", title }, ... }. A bio in a
  /// language other than its wiki is a translation of that article. Shown as a credit line.
  bioSources Json?

  portraitUrl    String?
  portraitSource String?
  // Artist, year and licence, e.g. "Elmju, 2009 · CC BY-SA 3.0" — shown with a link to portraitSource
  portraitCredit String?

  // Wikidata item (e.g. "Q312517"), for schema.org sameAs
  wikidataId String?

  status     PublishStatus @default(DRAFT)
  featuredAt DateTime?

  collections Collection[]
  works       Work[]
  tags        AuthorTag[]
  artworks    Artwork[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reader accounts
  favorites Favorite[]

  @@index([slug])
  @@index([nameAz])
  @@index([period])
  @@index([type])
}

// ── COLLECTION ────────────────────────────────

model Collection {
  id   String @id @default(cuid())
  slug String @unique

  titleAz String
  titleRu String?
  titleFa String?
  titleEn String?

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  year         Int?
  yearApprox   Boolean  @default(false)
  originalLang Language @default(AZ_LATIN)
  genre        Genre    @default(POEM)

  descriptionAz String? @db.Text
  descriptionRu String? @db.Text

  order  Int?
  status PublishStatus @default(DRAFT)

  works    Work[]
  artworks Artwork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reader accounts
  favorites Favorite[]
  bookState BookState[]
  listItems ReadingListItem[]

  @@index([authorId])
  @@index([slug])
}

// ── WORK ──────────────────────────────────────

model Work {
  id   String @id @default(cuid())
  slug String @unique

  titleAz String
  titleRu String?
  titleFa String?
  titleEn String?

  body     String  @db.Text
  bodyHtml String? @db.Text
  // Words in body, for the reading time; set by a database trigger on every write of body
  // (migration 20261119120000_work_word_count), never by the application
  wordCount Int @default(0)

  originalLang    Language
  scriptDirection ScriptDirection @default(LTR)

  genre Genre     @default(POEM)
  form  PoemForm?

  year       Int?
  yearApprox Boolean @default(false)

  order Int?

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])

  sourceNote String?

  // Stable import key (e.g. "ganjoor-27775"), so slugs can change without duplicating on re-import
  sourceId      String?  @unique
  // Old slugs that 301-redirect to the current one
  previousSlugs String[] @default([])

  status    PublishStatus @default(DRAFT)
  viewCount Int           @default(0)

  translations Translation[]
  tags         WorkTag[]
  submissions  Submission[]
  artworks     Artwork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reader accounts
  favorites    Favorite[]
  readingState ReadingState[]
  listItems    ReadingListItem[]

  @@index([authorId])
  @@index([previousSlugs], type: Gin)
  @@index([collectionId, order])
  @@index([slug])
  @@index([originalLang])
  @@index([year])
}

// ── ARTWORK ───────────────────────────────────

// Public-domain manuscript pages and miniatures from museum open-access collections,
// linked to the author and, when the subject is known, the collection or work they illustrate
model Artwork {
  id String @id @default(cuid())

  // Stable import key, e.g. "met-446603"
  sourceId String @unique

  title      String
  objectDate String?
  yearStart  Int?
  yearEnd    Int?
  medium     String?
  artists    String? // calligraphers and painters, as credited by the museum

  imageUrl         String
  imageSmallUrl    String?
  additionalImages String[] @default([])

  museum     String // "The Metropolitan Museum of Art"
  sourceUrl  String // the museum's object page
  creditLine String?
  license    String // "CC0"

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])

  workId String?
  work   Work?   @relation(fields: [workId], references: [id])

  order  Int?
  status PublishStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([collectionId])
  @@index([workId])
}

// ── TRANSLATION ───────────────────────────────

model Translation {
  id String @id @default(cuid())

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  language        Language
  type            TranslationType @default(TRANSLATION)
  scriptDirection ScriptDirection @default(LTR)

  body     String  @db.Text
  bodyHtml String? @db.Text

  translator     String?
  translatorNote String?
  year           Int?
  sourceNote     String?

  isDefault Boolean @default(false)

  status PublishStatus @default(DRAFT)

  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Several translations per language are allowed (different translators);
  // isDefault marks the one shown first, at most one per work + language: a partial unique
  // index ("Translation_workId_language_default_key" … WHERE "isDefault") created in migration
  // 20261118100000_translation_one_default, which Prisma's schema cannot express
  @@index([workId, language])
  @@index([workId])
  @@index([language])
}

// ── TAGS ──────────────────────────────────────

/// What a tag describes; tag pages and filters group by it
enum TagKind {
  THEME
  MOOD
  AUDIENCE
  ERA
}

/// Who put a tag on a work: the keyword rules (re-run freely) or an editor (kept).
/// REJECTED is an editor removing a tag: hidden from readers, and the rules won't re-add it.
enum TagSource {
  RULE
  EDITOR
  REJECTED
}

model Tag {
  id     String  @id @default(cuid())
  slug   String  @unique
  kind   TagKind @default(THEME)
  order  Int     @default(0)
  nameAz String
  nameRu String?
  nameEn String?

  authors AuthorTag[]
  works   WorkTag[]
}

model AuthorTag {
  authorId String
  tagId    String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([authorId, tagId])
}

model WorkTag {
  workId String
  tagId  String
  source TagSource @default(EDITOR)
  work   Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  tag    Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workId, tagId])
  @@index([tagId])
}

// ── SUBMISSIONS ───────────────────────────────

model Submission {
  id String @id @default(cuid())

  type   SubmissionType
  status SubmissionStatus @default(PENDING)

  // Contributor account, or contact details for anonymous public submissions
  userId       String?
  user         User?   @relation(fields: [userId], references: [id])
  contactName  String?
  contactEmail String?

  payload Json

  sourceNote String?

  authorId    String?
  author      Author?      @relation(fields: [authorId], references: [id])
  workId      String?
  work        Work?        @relation(fields: [workId], references: [id])
  translation Translation?

  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([type])
}

// ── BLOG ──────────────────────────────────────

model BlogPost {
  id   String @id @default(cuid())
  slug String @unique

  titleAz String
  titleRu String?
  titleEn String?

  bodyAz String  @db.Text
  bodyRu String? @db.Text
  bodyEn String? @db.Text

  excerpt  String?
  coverUrl String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  relatedAuthorId String?

  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  viewCount   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([publishedAt])
}

// ── READER ACCOUNTS ───────────────────────────
// Sessions are opaque random tokens in an HttpOnly cookie on /api; only their hash is stored.

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// A 6-digit sign-in code sent by mail: hashed, short-lived, limited attempts
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// Saved poems, books and authors: exactly one target per row
model Favorite {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId       String?
  work         Work?       @relation(fields: [workId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  authorId     String?
  author       Author?     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([userId, workId])
  @@unique([userId, collectionId])
  @@unique([userId, authorId])
  @@index([userId, createdAt])
}

enum ReadingStatus {
  READING
  DONE
}

// Per work: read or in progress, and where the reader stopped (0–1 through the whole text)
model ReadingState {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId        String
  work          Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  status        ReadingStatus @default(READING)
  progress      Float         @default(0)
  translationId String?
  updatedAt     DateTime      @updatedAt
  createdAt     DateTime      @default(now())

  @@unique([userId, workId])
  @@index([userId, updatedAt])
}

enum BookStatus {
  WANT
  READING
  DONE
}

// Per book (collection): want to read / reading / read, and the part last opened
model BookState {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  status       BookStatus
  lastWorkId   String?
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  @@unique([userId, collectionId])
  @@index([userId, status, updatedAt])
}

// Reader-made lists of books and works; private for now
model ReadingList {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  order     Int               @default(0)
  items     ReadingListItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, order])
}

model ReadingListItem {
  id           String      @id @default(cuid())
  listId       String
  list         ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  workId       String?
  work         Work?       @relation(fields: [workId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  order        Int         @default(0)
  createdAt    DateTime    @default(now())

  @@unique([listId, workId])
  @@unique([listId, collectionId])
  @@index([listId, order])
}
