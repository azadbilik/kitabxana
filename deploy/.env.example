# Copy to /opt/irs-az/.env on the server and fill in. Generate secrets with: openssl rand -hex 32
DOMAIN=kitabxana.az
TLS="/etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem"
IMAGE_TAG=latest
# Shown on /contact; leave empty until the mailbox exists
CONTACT_EMAIL=

POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILISEARCH_KEY=

# Cloudflare R2: nightly database backups (backup.sh)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_BUCKET=irs-az-backups

# Reader sign-in: mail through Resend (without the key sign-in by email is off), Google OAuth
MAIL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: post the poem of the day to a Telegram channel (bot must be a channel admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
# Hour of the day in Baku, 0-23
TELEGRAM_POST_HOUR=9
