# Plain HTTP inside the stack: cloudflared (the "kitabxana" named tunnel) terminates TLS at
# Cloudflare and connects out from the server, so no port is open to the internet.
:80 {
	encode zstd gzip
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} 308

	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
